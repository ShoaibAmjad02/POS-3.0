# =============================================================================
# Django Environment Variables
# =============================================================================
# Copy this file to .env in the project root and fill in your values.
# This file is read by django-environ when DJANGO_READ_DOT_ENV_FILE=True.

# ---------- Security ----------
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ---------- Debug ----------
DJANGO_DEBUG=False

# ---------- Database ----------
# MySQL (default)
DATABASE_URL=mysql://root:123456@localhost:3306/electricstore

# SQLite (alternative - uncomment and comment MySQL above)
# DATABASE_URL=sqlite:///C:/ProgramData/ElectricStore/db.sqlite3

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Email ----------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
DJANGO_SERVER_EMAIL=noreply@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# ---------- django-allauth ----------
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True
DJANGO_ADMIN_FORCE_ALLAUTH=False

# ---------- Admin URL ----------
DJANGO_ADMIN_URL=admin/

# ---------- Production AWS (optional) ----------
# DJANGO_AWS_ACCESS_KEY_ID=
# DJANGO_AWS_SECRET_ACCESS_KEY=
# DJANGO_AWS_STORAGE_BUCKET_NAME=
# DJANGO_AWS_REGION_NAME=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
