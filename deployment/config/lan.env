# =============================================================================
# LAN Deployment Environment Variables for Electric Store
# =============================================================================
# Copy this file to .env in the project root before running the server.
# For LAN deployment, most settings use safe defaults.

# ---------- Security ----------
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key-for-production
DJANGO_ALLOWED_HOSTS=*

# ---------- Debug ----------
DJANGO_DEBUG=False

# ---------- Database (MySQL) ----------
DATABASE_URL=mysql://root:123456@localhost:3306/pos

# ---------- Admin URL ----------
DJANGO_ADMIN_URL=admin/

# ---------- Email ----------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ---------- Logging ----------
DJANGO_LOG_FILE=deployment/logs/django.log

# ---------- django-allauth ----------
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True
DJANGO_ACCOUNT_EMAIL_VERIFICATION=none
